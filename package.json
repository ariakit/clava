{
  "name": "clava-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Clava monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariakit/clava.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest",
    "tsc": "tsc -b",
    "lint": "oxlint --type-aware --type-check . && oxfmt --check .",
    "lint-fix": "oxlint --type-aware --type-check --fix . && oxfmt .",
    "format": "oxfmt .",
    "format-check": "oxfmt --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/apply-release-plan": "7.1.0",
    "@changesets/cli": "2.30.0",
    "@changesets/config": "3.1.3",
    "@changesets/types": "6.1.0",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxfmt": "0.43.0",
    "oxlint": "1.58.0",
    "oxlint-tsgolint": "0.19.0",
    "rolldown": "1.0.0-rc.13",
    "rolldown-plugin-dts": "0.23.2",
    "solid-js": "1.9.12",
    "typescript": "6.0.2",
    "vite": "8.0.5",
    "vitest": "4.1.2"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,ts,jsx,tsx}": [
      "oxlint --type-aware --type-check"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "patchedDependencies": {
      "@changesets/apply-release-plan@7.1.0": "patches/@changesets__apply-release-plan@7.1.0.patch"
    }
  }
}
