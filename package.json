{
  "name": "clava-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Clava monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariakit/clava.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest",
    "tsc": "tsc -b",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "pnpm lint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-git": "0.2.1",
    "@changesets/cli": "2.29.8",
    "@changesets/config": "3.1.2",
    "@types/node": "25.3.1",
    "@types/react": "19.2.14",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oxfmt": "0.35.0",
    "oxlint": "1.50.0",
    "oxlint-tsgolint": "0.15.0",
    "rolldown": "1.0.0-rc.5",
    "rolldown-plugin-dts": "0.22.1",
    "solid-js": "1.9.11",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.0.18"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,ts,jsx,tsx}": [
      "oxlint --type-aware --type-check"
    ]
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4"
}
