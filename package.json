{
  "name": "clava-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Clava monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariakit/clava.git"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest",
    "tsc": "tsc -b",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "pnpm lint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-git": "0.2.1",
    "@changesets/cli": "2.29.8",
    "@changesets/config": "3.1.2",
    "@types/node": "25.2.2",
    "@types/react": "19.2.13",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oxfmt": "0.28.0",
    "oxlint": "1.43.0",
    "oxlint-tsgolint": "0.11.5",
    "rolldown": "1.0.0-rc.3",
    "rolldown-plugin-dts": "0.22.1",
    "solid-js": "1.9.11",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.0.18"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,ts,jsx,tsx}": [
      "oxlint --type-aware --type-check"
    ]
  },
  "packageManager": "pnpm@10.29.1+sha512.48dae233635a645768a3028d19545cacc1688639eeb1f3734e42d6d6b971afbf22aa1ac9af52a173d9c3a20c15857cfa400f19994d79a2f626fcc73fccda9bbc"
}
