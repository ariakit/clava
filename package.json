{
  "name": "clava-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Clava monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariakit/clava.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "bundle-size": "scripts bundle-size",
    "perf": "pnpm build && pnpm bench",
    "perf-compare": "scripts perf-compare",
    "perf-alternatives": "pnpm build && vitest bench --config vitest.alternatives.config.ts",
    "tsc": "tsc -b",
    "lint": "oxlint --type-aware --type-check . && oxfmt --check .",
    "lint-fix": "oxlint --type-aware --type-check --fix . && oxfmt .",
    "format": "oxfmt .",
    "format-check": "oxfmt --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/apply-release-plan": "8.1.1",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@changesets/types": "7.0.0",
    "@types/node": "26.6.5",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "scripts": "workspace:*",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.0"
}
