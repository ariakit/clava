      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "test": "vitest --config ../../vitest.config.ts --dir ."
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "csstype": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.7",
    "@types/react": "19.3.0",
    "rolldown": "1.2.8",
    "rolldown-plugin-dts": "0.28.6",
    "scripts": "workspace:*",
    "solid-js": "1.9.15",
    "test-utils": "workspace:*",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
