{
  "name": "clava",
  "version": "0.7.0",
  "description": "Clava library",
  "keywords": [
    "class variance",
    "clava",
    "css",
    "cva",
    "styles",
    "tailwind"
  ],
  "homepage": "https://clava.style",
  "license": "MIT",
  "author": {
    "name": "Diego Haz",
    "email": "hazdiego@gmail.com",
    "url": "https://github.com/diegohaz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariakit/clava.git",
    "directory": "packages/clava"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/ariakit"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "license"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
