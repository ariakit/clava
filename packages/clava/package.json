{
  "name": "clava",
  "version": "0.2.4",
  "description": "Clava library",
  "keywords": [
    "class variance",
    "clava",
    "css",
    "cva",
    "styles",
    "tailwind"
  ],
  "homepage": "https://clava.style",
  "license": "MIT",
  "author": {
    "name": "Diego Haz",
    "email": "hazdiego@gmail.com",
    "url": "https://github.com/diegohaz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariakit/clava.git",
    "directory": "packages/clava"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/ariakit"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#clava/warn": {
      "source": "./src/warn.ts",
      "development": "./dist/warn.js",
      "default": "./dist/warn.noop.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "test": "vitest"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "csstype": "^3.0.0"
  },
  "devDependencies": {
    "@rspack/core": "2.0.2",
    "esbuild": "0.28.0",
    "rolldown": "1.0.0",
    "rolldown-plugin-dts": "0.25.0",
    "vite": "8.0.12",
    "vitest": "4.1.6",
    "webpack": "5.106.2"
  }
}
